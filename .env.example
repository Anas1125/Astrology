APP_ENV=development
SECRET_KEY=replace-with-long-random-secret
DATABASE_URL=postgresql+psycopg://astroai:astroai@db:5432/astroai
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173
# Comma-separated exact proxy peer IPs; leave empty unless the reverse proxy is controlled/configured.
TRUSTED_PROXY_IPS=
# Deterministic chat has no daily cap; this per-user burst limit is shared by app workers via the DB.
AI_CHAT_RATE_LIMIT_PER_MINUTE=30
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5
PASSWORD_RESET_IP_RATE_LIMIT_PER_HOUR=20
# Configure SMTP to enable password recovery emails.
PASSWORD_RESET_SMTP_HOST=
PASSWORD_RESET_SMTP_PORT=587
PASSWORD_RESET_SMTP_USERNAME=
PASSWORD_RESET_SMTP_PASSWORD=
PASSWORD_RESET_SMTP_SENDER=
PASSWORD_RESET_SMTP_STARTTLS=true
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173
# Development only: write the latest reset URL to this mode-0600 local file instead of sending email.
# Never set this in staging or production.
PASSWORD_RESET_DEV_TOKEN_FILE=
# Server-side Geoapify key for authenticated birthplace autocomplete.
# Keep blank to disable search; manual coordinates/timezone entry remains available.
GEOAPIFY_API_KEY=
GEOCODING_REQUEST_TIMEOUT_SECONDS=5
GEOCODING_RATE_LIMIT_PER_MINUTE=20
# Keep Swiss .se1 files outside this repository; set this to their directory.
SWISSEPH_EPHE_PATH=
# Optional explicit path to libswe.dylib/libswe.so; the package normally bundles it.
SWISSEPH_LIBRARY_PATH=
# Public/staging/production calculation gates. Keep false unless runtime and licensing approval is completed.
ASTROLOGY_CALCULATIONS_ENABLED=false
SWISSEPH_LICENSE_CONFIRMED=false
# A separate local-only opt-in. backend/run_local.py forces this only for a loopback-bound local process.
# Do not set this in Docker, staging, production, or an externally reachable server.
ASTROLOGY_LOCAL_AGPL_DEVELOPMENT_ENABLED=false
